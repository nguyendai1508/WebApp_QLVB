{
  "manifest_version": 3,
  "name": "QLVB Sync Google Sheets",
  "version": "1.0",
  "description": "Bóc tách văn bản từ Sở Tài nguyên và Môi trường Đồng Nai lưu vào Google Sheets.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://qlvb-snnmt.dongnai.gov.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
