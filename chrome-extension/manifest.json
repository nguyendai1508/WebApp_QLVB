{
  "manifest_version": 3,
  "name": "QLVB Sync Web qlvbpr",
  "version": "1.0",
  "description": "Bóc tách văn bản từ Web Quản lý & Điều Hành Đồng Nai sang Web App QLVB.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dongnai.gov.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://qlvbpr.io.vn/*",
        "*://qlvb.io.vn/*",
        "*://localhost/*",
        "*://script.google.com/*",
        "*://*.script.googleusercontent.com/*"
      ],
      "js": [
        "webapp_content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}