          "content": {
            "size": 1043,
            "mimeType": "application/javascript",
            "compression": 650,
            "text": "    function YKien_PhieuChuyen(id_Ddl,id_NdPc) {        \r\n        $('#' + id_NdPc).val('');\r\n        var stringid = '#' + id_Ddl + ' :selected';\r\n        var kq = $(stringid).val(); ;\r\n            var strRetrun = '';\r\n            switch (kq) {\r\n                case '10400':\r\n                    strRetrun = 'Kính chuyển anh Đức chỉ đạo.'; break;\r\n                case '13665':\r\n                    strRetrun = 'Kính chuyển anh Tuấn Anh chỉ đạo.'; break;\r\n                case '12440':\r\n                    strRetrun = 'Kính chuyển anh Toàn chỉ đạo.'; break;\r\n                case '13192':\r\n                    strRetrun = 'Kính chuyển anh Thắng chỉ đạo.'; break;\r\n\t\t\t\tcase '15097':\r\n\t\t\t\t\tstrRetrun = 'Kính chuyển chị Tuyết chỉ đạo.'; break;\r\n\t\t\t\tcase '15098':\r\n\t\t\t\t\tstrRetrun = 'Kính chuyển anh Dinh chỉ đạo.'; break;\r\n\t\t\t\tcase '15099':\r\n\t\t\t\t\tstrRetrun = 'Kính chuyển anh Vũ chỉ đạo.'; break;\r\n            };\r\n            $('#' + id_NdPc).val(strRetrun);\r\n        };\r\n\r\n"
          },
