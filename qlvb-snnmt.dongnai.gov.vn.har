          "cookies": [],
          "content": {
            "size": 8925,
            "mimeType": "application/javascript",
            "compression": 7651,
            "text": "function OpenFileUpload_PhanCong() {\r\n    var myFrame = document.getElementById('frameUploadPhanCong');\r\n    $(myFrame).focus();\r\n    $(myFrame).contents().find(\"#filFileUpload\").click();\r\n    var value = $(myFrame).contents().find(\"#filFileUpload\").val();\r\n    if (value != '') {\r\n        $(myFrame).contents().find(\"#btnSubmit\").click();\r\n    }\r\n}\r\n\r\nfunction LanhDaoXuLyChinh(id) {\r\n    var objCheckbox = $(\".chkLanhDaoChinh-\" + id).find(\"input:checkbox\");\r\n    var isChecked = objCheckbox.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkLanhDaoPhoiHop-\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n        var objChiXem = $(\".chkLanhDaoChiXem-\" + id).find(\"input:checkbox\");\r\n        objChiXem.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction LanhDaoXuLyPhoiHop(id) {\r\n    var objCheckbox = $(\".chkLanhDaoPhoiHop-\" + id).find(\"input:checkbox\");\r\n    var isChecked = objCheckbox.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkLanhDaoChinh-\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n        var objChiXem = $(\".chkLanhDaoChiXem-\" + id).find(\"input:checkbox\");\r\n        objChiXem.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction LanhDaoXuLyChiXem(id) {\r\n    var objCheckbox = $(\".chkLanhDaoChiXem-\" + id).find(\"input:checkbox\");\r\n    var isChecked = objCheckbox.is(\":checked\");\r\n    if (isChecked) {\r\n        var objChinh = $(\".chkLanhDaoChinh-\" + id).find(\"input:checkbox\");\r\n        objChinh.prop('checked', false);\r\n        var objPhoiHop = $(\".chkLanhDaoPhoiHop-\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n    }\r\n}\r\n\r\n\r\nfunction PhongBanXuLyChinh(id) {\r\n\r\n    var objCheckbox = $(\".chkPhongBanXLChinh-\" + id).find(\"input:checkbox\");\r\n    var isChecked = objCheckbox.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkPhongBanXLPhoiHop-\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction PhongBanPhoiHop(id) {\r\n    var objCheckbox = $(\".chkPhongBanXLPhoiHop-\" + id).find(\"input:checkbox\");\r\n    var isChecked = objCheckbox.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkPhongBanXLChinh-\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction NhanVienXuLyChinh(id) {\r\n    var obj = $(\".chkNhanVienXlChinh\" + id).find(\"input:checkbox\");\r\n    var isChecked = obj.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkNhanVienXlPhoiHop\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n        var objPTrucTiep = $(\".chkNhanVienXlTrucTiep\" + id).find(\"input:checkbox\");\r\n        objPTrucTiep.prop('checked', false);\r\n        var objChiXem = $(\".chkNhanVienChiXem\" + id).find(\"input:checkbox\");\r\n        objChiXem.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction NhanVienXuLyPhoiHop(id) {\r\n    var obj = $(\".chkNhanVienXlPhoiHop\" + id).find(\"input:checkbox\"); \r\n    var isChecked = obj.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkNhanVienXlChinh\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n        var objPTrucTiep = $(\".chkNhanVienXlTrucTiep\" + id).find(\"input:checkbox\");\r\n        objPTrucTiep.prop('checked', false);\r\n        var objChiXem = $(\".chkNhanVienChiXem\" + id).find(\"input:checkbox\");\r\n        objChiXem.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction NhanVienXuLyTrucTiep(id) {\r\n    var obj = $(\".chkNhanVienXlTrucTiep\" + id).find(\"input:checkbox\");\r\n    var isChecked = obj.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkNhanVienXlPhoiHop\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n        var objPTrucTiep = $(\".chkNhanVienXlChinh\" + id).find(\"input:checkbox\");\r\n        objPTrucTiep.prop('checked', false);\r\n        var objChiXem = $(\".chkNhanVienChiXem\" + id).find(\"input:checkbox\");\r\n        objChiXem.prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction NhanVienXuLyChiXem(id) {\r\n    var obj = $(\".chkNhanVienChiXem\" + id).find(\"input:checkbox\");\r\n    var isChecked = obj.is(\":checked\");\r\n    if (isChecked) {\r\n        var objPhoiHop = $(\".chkNhanVienXlPhoiHop\" + id).find(\"input:checkbox\");\r\n        objPhoiHop.prop('checked', false);\r\n        var objPTrucTiep = $(\".chkNhanVienXlChinh\" + id).find(\"input:checkbox\");\r\n        objPTrucTiep.prop('checked', false);\r\n        var objChiXem = $(\".chkNhanVienXlTrucTiep\" + id).find(\"input:checkbox\");\r\n        objChiXem.prop('checked', false);\r\n    }\r\n}\r\n//code cũ\r\n//function NhanVienXlChinhCheckAll(number) {\r\n//    var obj = $(\".chkNvchinhAll\").find(\"input:checkbox\");\r\n//    var isCheck = obj.is(\":checked\");\r\n//    switch (number) {\r\n//        case 1:\r\n//        $(\".chk1\").find(\"input:checkbox\").prop('checked', isCheck);\r\n//        $(\".chk2\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk3\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk4\").find(\"input:checkbox\").prop('checked', false);\r\n//        break;\r\n//    case 2:\r\n//        $(\".chk1\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk2\").find(\"input:checkbox\").prop('checked', isCheck);\r\n//        $(\".chk3\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk4\").find(\"input:checkbox\").prop('checked', false);\r\n//        break;\r\n//    case 3:\r\n//        $(\".chk1\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk2\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk3\").find(\"input:checkbox\").prop('checked', isCheck);\r\n//        $(\".chk4\").find(\"input:checkbox\").prop('checked', false);\r\n//        break;\r\n//    case 4:\r\n//        $(\".chk1\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk2\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk3\").find(\"input:checkbox\").prop('checked', false);\r\n//        $(\".chk4\").find(\"input:checkbox\").prop('checked', isCheck);\r\n//        break;\r\n//    }\r\n//}\r\n\r\nfunction NhanVienXlChinhCheckAll(number) {\r\n    var obj = $(\".chkNvchinhAll\").find(\"input:checkbox\");\r\n    var isCheck = obj.is(\":checked\");\r\n    switch (number) {\r\n        case 1:\r\n            $(\".chk1\").each(function () {\r\n                if ($(this).closest(\"tr\").css(\"display\") !== \"none\") {\r\n                    $(this).find(\"input:checkbox\").prop(\"checked\", isCheck);\r\n                }\r\n            });\r\n            $(\".chk2\").find(\"input:checkbox\").prop(\"checked\", false);\r\n            $(\".chk3\").find(\"input:checkbox\").prop(\"checked\", false);\r\n            $(\".chk4\").find(\"input:checkbox\").prop(\"checked\", false);\r\n            break;\r\n        case 2:\r\n            $(\".chk2\").each(function () {\r\n                if ($(this).closest(\"tr\").css(\"display\") !== \"none\") {\r\n                    $(this).find(\"input:checkbox\").prop(\"checked\", isCheck);\r\n                }\r\n            });\r\n            $(\".chk1\").find(\"input:checkbox\").prop(\"checked\", false);\r\n            $(\".chk3\").find(\"input:checkbox\").prop('checked', false);\r\n            $(\".chk4\").find(\"input:checkbox\").prop('checked', false);\r\n            break;\r\n        case 3:\r\n            $(\".chk3\").each(function () {\r\n                if ($(this).closest(\"tr\").css(\"display\") !== \"none\") {\r\n                    $(this).find(\"input:checkbox\").prop(\"checked\", isCheck);\r\n                }\r\n            });\r\n            $(\".chk1\").find(\"input:checkbox\").prop('checked', false);\r\n            $(\".chk2\").find(\"input:checkbox\").prop('checked', false);\r\n            $(\".chk4\").find(\"input:checkbox\").prop('checked', false);\r\n            break;\r\n        case 4:\r\n            $(\".chk4\").each(function () {\r\n                if ($(this).closest(\"tr\").css(\"display\") !== \"none\") {\r\n                    $(this).find(\"input:checkbox\").prop(\"checked\", isCheck);\r\n                }\r\n            });\r\n            $(\".chk1\").find(\"input:checkbox\").prop('checked', false);\r\n            $(\".chk2\").find(\"input:checkbox\").prop('checked', false);\r\n            $(\".chk3\").find(\"input:checkbox\").prop('checked', false);\r\n            break;\r\n    }\r\n}\r\nfunction PhongBanXlCheckAll(number) {\r\n    var obj = $(\".chkPbAll\").find(\"input:checkbox\");\r\n    var isCheck = obj.is(\":checked\");\r\n    switch (number) {\r\n        case 1:\r\n            $(\".chkPb1\").each(function () {\r\n                if ($(this).closest(\"tr\").css(\"display\") !== \"none\") {\r\n                    $(this).find(\"input:checkbox\").prop(\"checked\", isCheck);\r\n                }\r\n            });\r\n            $(\".chkPb2\").find(\"input:checkbox\").prop(\"checked\", false);\r\n            break;\r\n        case 2:\r\n            $(\".chkPb2\").each(function () {\r\n                if ($(this).closest(\"tr\").css(\"display\") !== \"none\") {\r\n                    $(this).find(\"input:checkbox\").prop(\"checked\", isCheck);\r\n                }\r\n            });\r\n            $(\".chkPb1\").find(\"input:checkbox\").prop(\"checked\", false);\r\n            break;\r\n    }\r\n}"
          },
