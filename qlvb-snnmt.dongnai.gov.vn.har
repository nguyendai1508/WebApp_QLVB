            "mimeType": "application/javascript",
            "compression": 152,
            "text": "$(document).ready(function () {\r\n    clickDisableButton();\r\n});\r\nvar parameter = Sys.WebForms.PageRequestManager.getInstance();\r\nparameter.add_endRequest(function () {clickDisableButton();});\r\nfunction clickDisableButton() {$('.btnDisable').click(function () {$(this).attr(\"disabled\", true);});}\r\nfunction removeDisableButton() {$('.btnDisable').each(function () {$(this).attr(\"disabled\", false);});}"
