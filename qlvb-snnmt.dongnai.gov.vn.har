            "text": ".divofferheading{display: none}\r\n\r\n @media (max-width:768px)\r\n{\r\n   .offerstable tr{ display: block;margin: 5px 3px; border: 1px solid #dfdfdf}\r\n   .offerstable tr:first-child{display: none;}\r\n   .offerstable tr > td\r\n   {\r\n       border:none !important;\r\n       display: table;\r\n       width: 100% !important;\r\n       text-align: left; clear: both;\r\n   }\r\n   .divofferheading{display: table-cell;\r\n       vertical-align: top;width: 25%;background: #e1e1e1;\r\n       padding: 3px 5px;\r\n       font-weight: bold;\r\n       color: #444;\r\n       text-align: right;\r\n       padding-right: 10px !important;\r\n    }\r\n    .divOfferNoidung  \r\n    {\r\n        display:block;\r\n        padding-bottom: 3px;\r\n        padding-left: 5px;\r\n        padding-top: 3px;\r\n    }\r\n    .dropdown{display: inline-block}\r\n    \r\n    .pagination-ys {border: medium none; box-shadow: none;}\r\n    .pagination-ys tr {border: medium none;}\r\n    \r\n    .divOfferNoidung > table {display: block;}\r\n    .divOfferNoidung tbody {display: block;}\r\n    .divOfferNoidung tr {display: block !important; }\r\n    tr.pagination-ys {border: none !important;}\r\n    tr.pagination-ys > td .divofferheading {display: none;}\r\n    \r\n   .div-col-40 {display: block;float: left;}\r\n   #wrapper{margin-top:50px !important;} \r\n  .fix-top { top: 0; right:0; left:0; z-index:1200; width: 100%;  position: fixed !important;}\r\n}\r\n\r\n@media (max-width:414px)\r\n{\r\n    .fix-top { top: 0; right:0; left:0; z-index:1200; width: 100%;  position: fixed !important;}\r\n    #wrapper{margin-top:55px !important;} \r\n    .div-search{width:180px !important;}\r\n}\r\n\r\n@media (max-width:370px)\r\n{      \r\n    .div-search{width:160px !important;}\r\n        .logo-area {width: 71% !important}\r\n        #topnav .logo-area .toolbar-trigger a\r\n        {\r\n            margin-right: 15px !important;\r\n        }\r\n}\r\n\r\n@media all and (min-width:200px) \