            "mimeType": "application/javascript",
            "compression": 72,
            "text": "//Chuyển chuỗi không dấu\nfunction removeVietnameseTones(str) {\n    return str.normalize(\"NFD\") // Chuẩn hóa chuỗi về dạng tổ hợp Unicode\n        .replace(/[\\u0300-\\u036f]/g, \"\") // Loại bỏ dấu thanh\n        .replace(/đ/g, \"d\") // Chuyển đổi chữ \"đ\" thành \"d\"\n        .replace(/Đ/g, \"d\")\n        .toLowerCase(); // Chuyển thành chữ thường\n}"
          },
