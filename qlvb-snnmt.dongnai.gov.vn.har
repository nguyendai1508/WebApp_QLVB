          "cookies": [],
          "content": {
            "size": 8095,
            "mimeType": "application/javascript",
            "compression": 5141,
            "text": "//const { error } = require(\"jquery\");\r\n\r\nfunction check_iOS() {\r\n    return [\r\n            'iPad Simulator',\r\n            'iPhone Simulator',\r\n            'iPod Simulator',\r\n            'iPad',\r\n            'iPhone',\r\n            'iPod'\r\n        ].includes(navigator.platform)\r\n        // iPad on iOS 13 detection\r\n        || (navigator.userAgent.includes(\"Mac\") && \"ontouchend\" in document)\r\n}\r\n\r\nfunction getplatform() {\r\n    var plat = (navigator.platform || '').toLowerCase();\r\n    if (plat === 'android' || plat === 'linux') {\r\n        return 'android';\r\n    }\r\n    if (plat === 'blackberry') {\r\n        return 'blackberry';\r\n    }\r\n    if (plat === 'freebsd') {\r\n        return 'freebsd';\r\n    }\r\n    if (plat.indexOf('iphone') === 0 || plat.indexOf('pike ') === 0) {\r\n        return 'iphone';\r\n    }\r\n    if (plat.indexOf('ipad') === 0) {\r\n        return 'ipad';\r\n    }\r\n    if (plat.indexOf('ipod') === 0) {\r\n        return 'ipod';\r\n    }\r\n    if (plat.indexOf('mac') === 0) {\r\n        return 'mac';\r\n    }\r\n    if (plat.indexOf('linux') === 0) {\r\n        return 'linux';\r\n    }\r\n    if (plat.indexOf('win') === 0) {\r\n        return 'windows';\r\n    }\r\n}\r\n\r\nfunction modalPDF(idfile, tenfile) {\r\n    var url = \"../pDownload.aspx?FileDownload=\" + idfile + \"\";\r\n\r\n    if ((tenfile.toLowerCase().includes(\"pdf\")\r\n            || tenfile.toLowerCase().includes(\".doc\")\r\n            || tenfile.toLowerCase().includes(\".docx\")\r\n            //|| tenfile.toLowerCase().includes(\".xls\")\r\n            //|| tenfile.toLowerCase().includes(\".xlsx\")\r\n        )\r\n        && check_iOS() == false) {\r\n        $('#framePDF').prop('src', url);\r\n        $('#modalPDF').modal('show');\r\n        $('#TIEUDE_modalPDF').html(\"FILE: \" + tenfile);\r\n\r\n        //Gán nút download\r\n        var urlTaiVe = url + \"&fdownload=1\";\r\n        $('#btnModalFdownload').prop('href', urlTaiVe);\r\n        //Gán nút in\r\n        //var urlPrint = \"/pDownload.aspx?FilePrint=\" + idfile;\r\n        //$('#btnModalFprint').prop('href', urlPrint);\r\n        $('#idfile_modalpdf').val(idfile);\r\n\r\n        //Show tab file\r\n        getFilesCv(idfile)\r\n            .then(function (res) {\r\n                createMenuFile(res, idfile);\r\n            }).catch(function (error) {\r\n            console.log(error);\r\n        });\r\n    } else window.open(url, '_blank');\r\n}\r\n\r\nfunction modalPDF_CDDH(url, tenfile) {\r\n    //if (tenfile.includes(\"pdf\") && check_iOS() == false) {\r\n    //    $('#TIEUDE_modalPDF').html(\"FILE: \" + tenfile);\r\n    //    $('#framePDF').prop('src', url);\r\n    //    $('#modalPDF').modal('show');\r\n    //} else\r\n    window.open(url, '_blank');\r\n    //alert(url);\r\n    //if (url) $('<a href=\"' + url + '\" target=\"_blank\">')[0].click();\r\n}\r\n\r\nfunction modalPDF_VPCP(url, tenfile) {\r\n    if (tenfile.includes(\"pdf\") && check_iOS() == false) {\r\n        $('#TIEUDE_modalPDF').html(\"FILE: \" + tenfile);\r\n        $('#framePDF').prop('src', url);\r\n        $('#modalPDF').modal('show');\r\n    } else window.open(url, '_blank');\r\n}\r\n\r\nfunction getFilesCv(idF) {\r\n    return new Promise(function (resolve, reject) {\r\n        var myData = JSON.stringify({idFile: idF})\r\n        var ajaxSetting = {\r\n            type: \"POST\",\r\n            url: \"/MasterPages/pGetThongSo.aspx/GetListFiles\",\r\n            dataType: \"json\",\r\n            data: myData,\r\n            contentType: \"application/json; charset=utf-8\",\r\n            success: function (response) {\r\n                resolve(response.d);\r\n            },\r\n            error: function (jqXHR, textStatus, errorThrown) {\r\n                reject(errorThrown);\r\n            },\r\n            beforeSend: function (xhr) {\r\n\r\n            },\r\n            complete: function (xhr, status) {\r\n\r\n            }\r\n        };\r\n\r\n        $.ajax(ajaxSetting);\r\n    });\r\n}\r\n\r\nfunction createMenuFile(resData, idActive) {\r\n    const myMenu = document.getElementById('fileMenu');\r\n    const hidcv = document.getElementById('idcongvan_modalpdf');\r\n\r\n    if (!myMenu) return;\r\n    if (resData == \"\") return;\r\n    const pData = JSON.parse(resData);\r\n    const idcv = pData.idcongvan;\r\n    if (hidcv !== null) {\r\n        //nếu đã có idcv trước đó thì k cần gán lại\r\n        if (hidcv.value !== idcv)\r\n            hidcv.value = idcv;\r\n    }\r\n    const lst = pData.lstFiles;\r\n    //clear ul\r\n    if (myMenu.hasChildNodes) {\r\n        let child = myMenu.lastChild;\r\n        // Xóa từng phần tử con\r\n        while (child) {\r\n            myMenu.removeChild(child);\r\n            child = myMenu.lastChild;\r\n        }\r\n    }\r\n    lst.forEach(item => {\r\n        const li = document.createElement('li');\r\n        const label = document.createElement('label');\r\n        label.textContent = item.text.substring(0, 20);\r\n        //nếu là file đã xoá thì làm mờ\r\n        if (item.enabled === false) {\r\n            label.setAttribute('class', 'disabled');\r\n        }\r\n        //nếu là file đang mở thì active\r\n        if (item.id == idActive)\r\n            li.setAttribute('class', 'active');\r\n        //add sự kiện\r\n        li.addEventListener('click', () => {\r\n            resetStyleList(li);\r\n            li.setAttribute('class', 'active');\r\n            openFileInModal(item.id, item.text);\r\n        });\r\n        //thêm icon\r\n        const i = document.createElement('i');\r\n        let color, faIcon;\r\n        switch (item.text.split('.').pop().toUpperCase()) {\r\n            case \"PDF\":\r\n                color = \"#ff0000\";\r\n                faIcon = \"fa fa-file-pdf-o\";\r\n                break;\r\n            case \"DOC\":\r\n            case \"DOCX\":\r\n                color = \"#0000ff\";\r\n                faIcon = \"fa fa-file-word-o\";\r\n                break;\r\n            case \"XLS\":\r\n            case \"XLSX\":\r\n                color = \"#00cc00\";\r\n                faIcon = \"fa fa-file-excel-o\";\r\n                break;\r\n            case \"PPT\":\r\n            case \"PPTX\":\r\n                color = \"#ff6600\";\r\n                faIcon = \"fa fa-file-powerpoint-o\";\r\n                break;\r\n            case \"ZIP\":\r\n            case \"RAR\":\r\n                color = \"#cc0066\";\r\n                faIcon = \"fa fa-file-archive-o\";\r\n                break;\r\n            case \"PNG\":\r\n            case \"JPG\":\r\n            case \"JPEG\":\r\n                color = \"#ff9900\";\r\n                faIcon = \"fa fa-file-image-o\";\r\n                break;\r\n            default:\r\n                color = \"#cc3300\";\r\n                faIcon = \"fa fa-download\";\r\n                break;\r\n        }\r\n        i.style.color = color;\r\n        i.className = faIcon;\r\n        //tạo span bọc 2 đt trên\r\n        const span = document.createElement('span');\r\n\r\n        span.appendChild(i);\r\n        span.appendChild(label);\r\n\r\n        li.appendChild(span);\r\n        myMenu.appendChild(li);\r\n    });\r\n}\r\n\r\nfunction openFileInModal(idfile, tenfile) {\r\n    var url = \"/pDownload.aspx?FileDownload=\" + idfile;\r\n    if ((tenfile.split('.').pop().toUpperCase() == \"PDF\"\r\n            || tenfile.split('.').pop().toUpperCase() == \"DOC\"\r\n            || tenfile.split('.').pop().toUpperCase() == \"DOCX\"\r\n            //|| tenfile.split('.').pop().toUpperCase() == \"XLS\"\r\n            //|| tenfile.split('.').pop().toUpperCase() == \"XLSX\"\r\n        )\r\n        && check_iOS() == false) {\r\n        $('#framePDF').prop('src', url);\r\n        $('#TIEUDE_modalPDF').html(\"FILE: \" + tenfile);\r\n        //Gán nút download\r\n        var urlTaiVe = url + \"&fdownload=1\";\r\n        $('#btnModalFdownload').prop('href', urlTaiVe);\r\n        //Gán nút in\r\n        //var urlPrint = \"/pDownload.aspx?FilePrint=\" + idfile;\r\n        //$('#btnModalFprint').prop('href', urlPrint);\r\n        $('#idfile_modalpdf').val(idfile);\r\n    } else window.open(url, '_blank');\r\n}\r\n\r\nfunction resetStyleList(childLi) {\r\n    const parentUl = childLi.parentNode;\r\n    if (parentUl.tagName === 'UL') {\r\n        const childLiElements = parentUl.querySelectorAll('li');\r\n\r\n        childLiElements.forEach(li => {\r\n            li.removeAttribute('class', 'active');\r\n        });\r\n    } else {\r\n        console.error('Phần tử cha không phải là thẻ ul');\r\n    }\r\n}\r\n"
          },
