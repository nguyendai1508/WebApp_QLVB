          "content": {
            "size": 6464,
            "mimeType": "application/javascript",
            "compression": 3760,
            "text": "function myFunction(para) {\r\n    $(document).ready(function () {\r\n        $('li.nav-item').removeClass('active');\r\n        $('span.' + para).parent().parent().addClass('active');\r\n        $(\".\" + para).removeClass('display-none');\r\n    });\r\n}\r\n\r\n$(document).ready(function () {\r\n    //Hiển thị màu chọn \r\n    $(\".tableMonth tr td\").click(function () {\r\n        var classCurent = $(this).attr('class');\r\n        if (classCurent == 'td-color-primary')\r\n            $(this).removeClass('td-color-primary');\r\n        else\r\n            $(this).addClass('td-color-primary');\r\n    });\r\n\r\n    //dùng trong các menu danh mục. Di chuyển đến một vị trí nào đó.\r\n    $('a.a-danhmuc').click(function () {\r\n        var ida = $(this).attr('title');\r\n        $('html, body').animate({\r\n            scrollTop: $(\"#\" + ida).offset().top - 100\r\n        }, 500);\r\n        $('.h4-title').removeClass('bg-yellow');\r\n        $('#' + ida).addClass(\"bg-yellow\");\r\n    });\r\n\r\n    $(function () {\r\n        $('.date-input').datepicker({ format: \"dd/mm/yyyy\" });\r\n    });\r\n\r\n    //Show các thông tin hợp đồng nhân viên\r\n    $('.chk-chon input:checkbox').click(function () {\r\n        if ($(this)[0].checked) {\r\n            $('.chk-chon input:checkbox').attr(\"checked\", false);\r\n            $(this)[0].checked = true;\r\n            $('div.hide-action').slideDown(false);\r\n        } else {\r\n            $('div.hide-action').slideUp(false);\r\n        }\r\n    });\r\n\r\n    //Thay đổi label file upload.\r\n    $('.fileinput-remove span.hidden-xs').html('Xóa file');\r\n    $('.btn-file span.hidden-xs').html('Chọn file');\r\n    $('.btn-file').removeClass('btn-primary').addClass('btn-default');\r\n\r\n    //Ẩn hiện trong ucNghiPhep\r\n    $('.click-div').click(function () {\r\n        var giatri = $(this).attr('title');\r\n        if (giatri == \"Nhấn chọn để ẩn thông tin\") {\r\n            $('div.show-hide-div').slideUp();\r\n            $(this).attr('title', 'Nhấn chọn để hiển thị thông tin');\r\n            $(this).find(\"span\").removeClass(\"fa-angle-up\");\r\n            $(this).find(\"span\").addClass(\"fa-angle-down\");\r\n        } else {\r\n            $('div.show-hide-div').slideDown();\r\n            $(this).attr('title', 'Nhấn chọn để ẩn thông tin');\r\n            $(this).find(\"span\").addClass(\"fa-angle-up\");\r\n            $(this).find(\"span\").removeClass(\"fa-angle-down\");\r\n        }\r\n    });\r\n\r\n    //Tabs custom\r\n    $('.ul-tab-custom > li a').click(function () {\r\n        var idtab = $(this).attr('href');\r\n        $(idtab).addClass('active-custom');\r\n        $('.ul-tab-custom > li').removeClass('li-active-custom');\r\n        $(this).parent().addClass('li-active-custom');\r\n    });\r\n\r\n});\r\n\r\n//Begin Sự kiện chọn TreeView\r\nfunction OnTreeClick(evt) {\r\n    var src = window.event != window.undefined ? window.event.srcElement : evt.target;\r\n    var isChkBoxClick = (src.tagName.toLowerCase() == \"input\" && src.type == \"checkbox\");\r\n    var t = GetParentByTagName(\"table\", src);\r\n    if (isChkBoxClick) {\r\n        var parentTable = GetParentByTagName(\"table\", src);\r\n        var nxtSibling = parentTable.nextSibling;\r\n        if (nxtSibling && nxtSibling.nodeType == 1) {\r\n            if (nxtSibling.tagName.toLowerCase() == \"div\") {\r\n                CheckUncheckChildren(parentTable.nextSibling, src.checked);\r\n            }\r\n        }\r\n        //CheckUncheckParents(src, src.checked);\r\n    }\r\n}\r\nfunction CheckUncheckChildren(childContainer, check) {\r\n    var childChkBoxes = childContainer.getElementsByTagName(\"input\");\r\n    var childChkBoxCount = childChkBoxes.length;\r\n    for (var i = 0; i < childChkBoxCount; i++) {\r\n        childChkBoxes[i].checked = check;\r\n    }\r\n}\r\nfunction CheckUncheckParents(srcChild, check) {\r\n    var parentDiv = GetParentByTagName(\"div\", srcChild);\r\n    var parentNodeTable = parentDiv.previousSibling;\r\n\r\n    if (parentNodeTable) {\r\n        var checkUncheckSwitch;\r\n        var isAllSiblingsChecked = AreAllSiblingsChecked(srcChild);\r\n        if (isAllSiblingsChecked) {\r\n            checkUncheckSwitch = true;\r\n        }\r\n        else {\r\n            checkUncheckSwitch = false;\r\n        }\r\n        var inpElemsInParentTable = parentNodeTable.getElementsByTagName(\"input\");\r\n        if (inpElemsInParentTable.length > 0) {\r\n            var parentNodeChkBox = inpElemsInParentTable[0];\r\n            parentNodeChkBox.checked = checkUncheckSwitch;\r\n\r\n            CheckUncheckParents(parentNodeChkBox, checkUncheckSwitch);\r\n        }\r\n    }\r\n}\r\nfunction AreAllSiblingsChecked(chkBox) {\r\n    var parentDiv = GetParentByTagName(\"div\", chkBox);\r\n    var childCount = parentDiv.childNodes.length;\r\n    var k = 0;\r\n    for (var i = 0; i < childCount; i++) {\r\n        if (parentDiv.childNodes[i].nodeType == 1) {\r\n            if (parentDiv.childNodes[i].tagName.toLowerCase() == \"table\") {\r\n                var prevChkBox = parentDiv.childNodes[i].getElementsByTagName(\"input\")[0];\r\n                //if any of sibling nodes are not checked, return false\r\n                if (prevChkBox.checked) {\r\n                    //add each selected node one value\r\n                    k = k + 1;\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    //Finally check any one of child node is select if selected yes then return ture parent node check\r\n\r\n    if (k > 0) {\r\n        return true;\r\n    }\r\n    else {\r\n        return false;\r\n    }\r\n}\r\nfunction GetParentByTagName(parentTagName, childElementObj) {\r\n    var parent = childElementObj.parentNode;\r\n    while (parent.tagName.toLowerCase() != parentTagName.toLowerCase()) {\r\n        parent = parent.parentNode;\r\n    }\r\n    return parent;\r\n}\r\n//End Sự kiện chọn TreeView\r\n\r\nfunction setValue_MultiSelectControl(ddlID, hfID) {\r\n    var values = $(\"#\" + hfID).val();\r\n    var arrVal = values.split(\",\");\r\n    //console.log(arrVal);\r\n    $(\"#\" + ddlID).find(\"option\").each(function (index, option) {\r\n        if ($(option).attr(\"data-type\") === \"pb\" && arrVal.indexOf($(option).val()) !== -1) {\r\n            $(option).prop(\"selected\", true);\r\n        }\r\n    });\r\n\r\n    $(\"#\" + ddlID).trigger('change');\r\n    /*$(\"#\" + ddlID).val(arrVal).trigger('change');*/\r\n}\r\nfunction getValue_MultiSelectControl(ddlID, hfID, hfIDNhom) {\r\n    //var lstNpb = $(\"#\" + ddlID).find(':selected').attr('data-type','nhompb');    \r\n    //console.log(lstNpb);\r\n    \r\n    $(\"#\" + hfID).val(lstPb.toString());\r\n    $(\"#\" + hfIDNhom).val(lstNpb.toString());\r\n    return true;\r\n}\r\n"
          },
