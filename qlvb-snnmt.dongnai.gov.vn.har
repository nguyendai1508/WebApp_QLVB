            "text": "\r\n\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n    <style>\r\n        body\r\n        {\r\n            margin: 0;\r\n            padding: 0;\r\n            width: 100%;\r\n        }\r\n        .table-file\r\n        {\r\n            width: 100%;\r\n        }\r\n        .table-file tbody > tr\r\n        {\r\n            display: inline-block;\r\n        }\r\n        .table-file tbody > tr td\r\n        {\r\n            display: inline;\r\n            overflow: hidden;\r\n        }\r\n        .ul-FileUpload\r\n        {\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n        .ul-FileUpload li\r\n        {\r\n            display: inline-block;\r\n            margin-left: 23px;\r\n        }\r\n        .ul-FileUpload li > a\r\n        {\r\n            color: #333;\r\n            text-align: left;\r\n            text-decoration: none;\r\n        }\r\n        .lnk-delete\r\n        {\r\n            color: red !important;\r\n        }\r\n    </style>\r\n    <link href=\"../Assets/fonts/font-awesome/css/font-awesome.min.css\" rel=\"stylesheet\" type=\"text/css\" /><title>\r\n\r\n</title></head>\r\n<body>\r\n    <form method=\"post\" action=\"./pFileUpload.aspx?fFileYKien=1\" id=\"form1\" enctype=\"multipart/form-data\">\r\n<div class=\"aspNetHidden\">\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"fRpgJyBDeD9vGE5pkNbpbHl29w1eBv+jJkt/AUDmu5pmEAi1yQJkVaKXFt63wX2xDPz+Wy/OsLgnZlcckXLS1X7RRJ1pVfSFaqO3N93Hrk3E5fplViT+oxqAIdGQoe05/MjhXLm7YbnZ2elIY8mjwAImdiHKDs69baNFu2nhV5YGKrKgvGPMFv+o9BUHyexbkEOgp+xq6llVHd/MlFk68A==\" />\r\n</div>\r\n\r\n<div class=\"aspNetHidden\">\r\n\r\n\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"4FB1AEE6\" />\r\n\t<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"imJF