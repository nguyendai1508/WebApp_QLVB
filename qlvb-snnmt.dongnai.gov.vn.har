            "size": 3354,
            "mimeType": "text/html",
            "compression": 1593,
            "text": "\r\n\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n    <style>\r\n        body\r\n        {\r\n            margin: 0;\r\n            padding: 0;\r\n            width: 100%;\r\n        }\r\n        .table-file\r\n        {\r\n            width: 100%;\r\n        }\r\n        .table-file tbody > tr\r\n        {\r\n            display: inline-block;\r\n        }\r\n        .table-file tbody > tr td\r\n        {\r\n            display: inline;\r\n            overflow: hidden;\r\n        }\r\n        .ul-FileUpload\r\n        {\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n        .ul-FileUpload li\r\n        {\r\n            display: inline-block;\r\n            margin-left: 23px;\r\n        }\r\n        .ul-FileUpload li > a\r\n        {\r\n            color: #333;\r\n            text-align: left;\r\n            text-decoration: none;\r\n        }\r\n        .lnk-delete\r\n        {\r\n            color: red !important;\r\n        }\r\n    </style>\r\n    <link href=\"../Assets/fonts/font-awesome/css/font-awesome.min.css\" rel=\"stylesheet\" type=\"text/css\" /><title>\r\n\r\n</title></head>\r\n<body>\r\n    <form method=\"post\" action=\"./pFileUpload.aspx?fFileYKien=1\" id=\"form1\" enctype=\"multipart/form-data\">\r\n<div class=\"aspNetHidden\">\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"7/6GczMmdZ41BLkEpZW5uGd6lA79BKNN91CEy/9Jgx8fwrwbehG2fBHQV+oSURIoKfvDVO3wfUdDQ7iASh3zXDogNBDJxsHHSm6gdTmSukPhBMxeB118FTv8BXluisA1obn+feJYHRyODIXEO5zEjocaDfMy+4nw2CH25JEnyuTWDqJrvllC4AsHejdviZFgvYXTxgtUqx3PP/bzoM9HhQ==\" />\r\n</div>\r\n\r\n<div class=\"aspNetHidden\">\r\n\r\n\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"4FB1AEE6\" />\r\n\t<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"yr4gibH1azXjgkCrNXemp5Rccm1Md+2C92+0WQ6Nz9rPbdULxE6g7epjt/Q6g9Sppk1+7P0PuvrQw5V+n28KPacGUymYykVvvXV/gJ0d181xia0W4nZ+Z9Pw0fE8DbDY\" />\r\n</div>\r\n    <div>\r\n        <span id=\"lblMessage\" style=\"color:Red;padding: 0px; margin: 25px;\r\n            font-size: 11px\"></span>\r\n        \r\n        <div class=\"file-wrapper\">\r\n        \r\n            </div>\r\n        <div style=\"width: 0px; height: 0px; background-color: transparent\">\r\n            <input type=\"file\" name=\"filFileUpload\" id=\"filFileUpload\" multiple=\"multiple\" onchange=\"doFileUpload();\" style=\"display: none;\" />\r\n            <input type=\"submit\" name=\"btnSubmit\" value=\"Submit\" id=\"btnSubmit\" style=\"display: none;\" />\r\n        </div>\r\n    </div>\r\n    <script language=\"javascript\" type=\"text/javascript\">\r\n        function doFileUpload() {\r\n            var fi = document.getElementById('filFileUpload');\r\n            if (fi.files[0].size >= 104857600) {\r\n                alert('Dung lượng file lớn hơn 100MB. Vui lòng chọn file dung lượng nhỏ hơn !');\r\n                document.location.reload(true);\r\n            }\r\n            else if (/\\.{3,}/.test(fi.files[0].name)) {\r\n                alert('Vui lòng đặt tên file không chứa ký tự ... ');\r\n                document.location.reload(true);\r\n            }\r\n            else {\r\n                document.getElementById('btnSubmit').click();\r\n            }\r\n        }\r\n\r\n        function FILEDONE() {\r\n            //parent.loadFile();            \r\n        }\r\n        \r\n    </script>\r\n    </form>\r\n</body>\r\n</html>\r\n"
