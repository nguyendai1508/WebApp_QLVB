!important;\r\n            padding-left: 5px !important;\r\n        }\r\n\r\n.divHide {\r\n    display: none !important\r\n}\r\n\r\n.divShow {\r\n    display: block !important\r\n}\r\n\r\n.completionList {\r\n    border: solid 1px #444444;\r\n    margin: 0px;\r\n    padding: 2px;\r\n    height: 400px;\r\n    overflow: auto;\r\n    background-color: #FFFFFF;\r\n    position: absolute;\r\n    z-index: 999999;\r\n}\r\n\r\n    .completionList > li {\r\n        padding: 3px 5px 3px 10px;\r\n        border-bottom: 1px dotted #ccc;\r\n    }\r\n\r\n.listItemComplete {\r\n    color: #1C1C1C;\r\n}\r\n\r\n.itemHighlighted {\r\n    background-color: #fdfdfd;\r\n}\r\n\r\n\r\n/* Shore more styles */\r\n.showmore_content {\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.showmore_trigger {\r\n    width: 100%;\r\n    cursor: pointer;\r\n}\r\n\r\n    .showmore_trigger span {\r\n        display: block;\r\n    }\r\n\r\n.more, .less {\r\n    color: #ad2e38;\r\n    display: block;\r\n    float: right;\r\n    font-size: 12px;\r\n    font-style: italic;\r\n    padding: 0 3px;\r\n    text-align: center;\r\n    width: 75px;\r\n    background: rgba(0, 0, 0, 0) url(\"../img/more-less.png\") no-repeat scroll 0 5px;\r\n}\r\n\r\n.less {\r\n    color: #336699 !important;\r\n    background-position: 0px -17px;\r\n    border: 1px solid;\r\n}\r\n\r\n    .less:hover {\r\n        border: 1px solid #336699 !important\r\n    }\r\n\r\n.more:hover {\r\n    border: 1px solid #ad2e38;\r\n    color: #ad2e38;\r\n}\r\n\r\n.tableNoborder {\r\n    border: none;\r\n}\r\n\r\n    .tableNoborder tr > td {\r\n        border: none\r\n    }\r\n\r\n    .tableNoborder tr {\r\n        display: inline-block\r\n    }\r\n\r\n.div-NgayThangchiDao {\r\n    color: #666;\r\n    font-size: 13px;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n\r\n.demo-options .demo-options-icon {\r\n    width: 20px !important;\r\n    height: 20px !important;\r\n    left: -20px !important;\r\n}\r\n\r\n.ti-paint-bucket {\r\n    left: 1px;\r\n    position: absolute;\r\n    top: -15px;\r\n}\r\n\r\n.morecontent span {\r\n    display: none;\r\n}\r\n\r\n.morelink {\r\n    display: block;\r\n}\r\n\r\n.spanXuLyCHINH, .spanXuLyXEM, .spanXuLyPHOIHOP, .spanXINYKIEN {\r\n    display: inline-block !important;\r\n}\r\n\r\n.spanXuLyCHINH {\r\n    color: #D5455E\r\n}\r\n\r\n.spanXINYKIEN {\r\n    color: Red\r\n}\r\n\r\n.spanXuLyPHOIHOP {\r\n    color: #EEA303\r\n}\r\n\r\n.spanXuLyXEM {\r\n    color: #336699\r\n}\r\n\r\n.chuaxuly, .CHUAXULY {\r\n    background: #ff2a00 none repeat scroll 0 0;\r\n    color: #fff !important;\r\n    display: inline-block !important;\r\n    font-size: 10px;\r\n    margin-top: 4px;\r\n    padding: 0 3px;\r\n}\r\n\r\n.isxulylai, .isXULYLAI {\r\n    border: #ff2a00 solid 1px;\r\n    color: #ff2a00 !important;\r\n    display: inline-block !important;\r\n    font-size: 10px;\r\n    margin-top: 4px;\r\n    padding: 0 3px;\r\n}\r\n\r\n.a-view-chuyenvien {\r\n    display: inline-block;\r\n    float: right;\r\n    color: orange;\r\n}\r\n\r\n.anti-autofill[readonly] {\r\n    cursor: auto;\r\n    background-color: transparent;\r\n    opacity: 1;\r\n}\r\n\r\n.divOfferNoidung ul {\r\n    padding-left: 10px;\r\n}\r\n\r\n.chiTietHoSo input[type=\"text\"] {\r\n    border: none;\r\n}\r\n\r\nul[id*='_AutoCompleteExtender'] {\r\n    padding: 5px 0px !important;\r\n    border: 1px solid #ced4da !important;\r\n    font-size: 16px;\r\n    height: 400px;\r\n    overflow: auto;\r\n}\r\n\r\nul[id*='_AutoCompleteExtender'] li {\r\n    margin: 5px 5px;\r\n}\r\n\r\n.deleted-file a {\r\n    color: gray !important;\r\n}\r\n.select2-container--default .select2-selection--single .select2-selection__rendered {\r\n    color: #444;\r\n    line-height: 28px;\r\n    font-size: 14px !important;\r\n}\r\n.select2-container--default .select2-selection--multiple .select2-selection__choice__display {\r\n    cursor: default;\r\n    padding-left: 2px;\r\n    padding-right: 5px;\r\n    font-size: 15px;\r\n}\r\n.select2-container--default .select2-results > .select2-results__options {\r\n    max-height: 400px;\r\n    min-height: 400px;\r\n    overflow-y: auto;\r\n}\r\n.select2-container .select2-selection--multiple {\r\n    box-sizing: border-box;\r\n    display: block;\r\n    min-height: 100px !important;\r\n}\r\n.select-one-line + .select2-container .select2-selection--multiple {\r\n    min-height: 34px !important;\r\n}\r\n.select2-container--default .select2-selection--multiple .select2-selection__choice {\r\n    background-color: #5b8edb;\r\n    border: 1px solid #0f3a66;\r\n}\r\n.select2-container--default .select2-selection--multiple .select2-selection__choice:has(span.pb) {\r\n    color: #0075ff;\r\n}\r\n.select2-container--default .select2-selection--multiple .select2-selection__choice:has(span.nhompb) {\r\n    color: #ff2a00;\r\n}\r\n.select2-container--default .select2-selection--multiple .select2-selection__choice__remove {\r\n    color: #f9f1f1;\r\n}\r\n.select2-fix-position {\r\n    position: fixed !important;\r\n    top: auto !important;\r\n    left: auto !important;\r\n}\r\n#fileMenu {\r\n    list-style: none;\r\n    /*display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: center;*/\r\n}\r\n    #fileMenu {\r\n        padding-left:10px !important;\r\n    }\r\n    #fileMenu li {\r\n        height: 30px;\r\n        margin: 5px;\r\n        padding: 5px !important;\r\n        border: 1px solid #ccc;\r\n        border-radius: 5px;\r\n        overflow: hidden;\r\n    }\r\n        #fileMenu li span {\r\n            display: inline-flex !important;\r\n        }\r\n        #fileMenu li span i {\r\n            margin-right: 5px !important;\r\n        }\r\n#fileMenu li span label {\r\n    font-size: 14px;\r\n    color: black;\r\n}\r\n#fileMenu li span label.disabled {    \r\n    color: #ccc;\r\n}\r\n#fileMenu li:hover {\r\n    background-color:darkgrey;\r\n}\r\n#fileMenu li.active {\r\n    background-color: #27aaf07d;\r\n}\r\n.tooltip-container {\r\n    position: relative;\r\n    display: inline-block;\r\n}\r\n\r\n.tooltip-content {\r\n    visibility: hidden;\r\n    background-color: #2893d1;\r\n    color: #fff;\r\n    text-align: left;\r\n    padding: 5px 10px;\r\n    border-radius: 5px;\r\n    position: absolute;\r\n    bottom: 100%; /* Đẩy popup lên trên */\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n    white-space: nowrap;\r\n    z-index: 10;\r\n    opacity: 0;\r\n    transition: opacity 0.3s;\r\n}\r\n\r\n.tooltip-container:hover .tooltip-content {\r\n    visibility: visible;\r\n    opacity: 1;\r\n}"
