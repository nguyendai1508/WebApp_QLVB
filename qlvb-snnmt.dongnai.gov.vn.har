            "text": "\t.tab\r\n{\r\n\twidth:95%;\t\r\n\ttext-align:left;\r\n    margin-right: 59px;\r\n   /* height: 540px;*/\r\n}\r\n.tabGrid\r\n{\t\t\r\n\tborder:solid 1px #89692A;\r\n    width: 100%;\r\n}\r\ntr.gridA\r\n{\r\n\tbackground-color:White;\r\n\theight:25px;\t\r\n\tpadding-top:7px;\r\n\tpadding-bottom:7px;\t\r\n\tcolor:Black;\r\n}\r\ntr.gridA:hover\r\n{\r\n\tbackground-color:#F5F5DC  ;\r\n\theight:25px;\t\r\n\tpadding-top:7px;\r\n\tpadding-bottom:7px;\r\n}\r\ntr.gridB:hover\r\n{\r\n\tbackground-color:#F5F5DC  ;\r\n\theight:22px;\t\r\n}\r\ntr.gridB1:hover\r\n{\r\n\tbackground-color:#F5F5DC  ;\r\n\theight:25px;\t\r\n\tpadding-top:7px;\r\n\tpadding-bottom:7px;\r\n}\r\ntr.gridS\r\n{\r\n\tbackground-color:#FDD27F;\r\n\theight:22px;\r\n}\r\n\r\ntr.gridB\r\n{    \r\n\tbackground-color:#F0F9FD;\r\n\theight:22px;\r\n\tcolor:Black;\r\n}\r\ntr.gridHeader\r\n{\r\n\ttext-align:center;\r\n\theight:25px;\r\n\tcolor:White;\r\n\tfont-family:Tahoma;\r\n\tfont-size:13px;\r\n\tbackground-image:url(Images/bg-headergrid2.gif);\r\n\tfont-weight:bold;\r\n}\r\ntr.gridHeader1 td\r\n{\r\n\ttext-align:center;\r\n\theight:25px;\r\n\tcolor:White;\r\n\tfont-family:Tahoma;\r\n\tfont-size:13px;\t\r\n\tfont-weight:bold;\t\r\n\tcolor:White;\r\n\tborder: 1px ridge #999999; \r\n    box-shadow: inset 0px -13px 3px 0px #548C31;\r\n    -webkit-box-shadow: inset 0px -13px 3px 0px #548C31;\r\n    -moz-box-shadow:  inset 0px -13px 3px 0px #548C31;\r\n    background-color:#66B12F;\r\n}\r\ntr.gridB1\r\n{\r\n\tbackground-color:#F0F9FD;\r\n\theight:25px;\t\r\n\tpadding-top:10px;\r\n\tpadding-bottom:10px;\r\n}\r\ntd.cellDate\r\n{\r\n\tpadding-right:5px;\r\n\tpadding-left:5px;\r\n\ttext-align:right;\r\n}\r\n\r\ntd.cellTitle\r\n{\r\n\tpadding-right:5px;\r\n\tpadding-left:5px;\r\n\ttext-align:left;\r\n\t\r\n}\r\ntd.gridTitleDetail\r\n{\r\n    background-color:#E6E6F2;\r\n}\r\ntd.gridContentDetail\r\n{\r\n    background-color:#D0E1EA;\r\n}\r\n.divScroll\r\n        {\r\n            background: #fff none repeat scroll 0 0;\r\n          \r\n            margin-top: 2px;\r\n            overflow: auto;\r\n            max-height: 350px;\r\n        }\r\n        .divChiTietHoSoCongViec\r\n        {\r\n            background: #fff none repeat scroll 0 0;\r\n            border: 1px solid #ccc;\r\n            border-radius: 5px;\r\n            margin-top: 2px;\r\n            overflow: auto;\r\n            max-height: 350px;\r\n        }\r\n        .table-chitiet\r\n        {\r\n            border: none;\r\n        }\r\n        .table-chitiet > tr\r\n        {\r\n            border-bottom: 1px inset #dcdcdc !important;\r\n        }\r\n        .table-chitiet tr > td\r\n        {\r\n            border: none !important;\r\n            border-bottom: 1px solid #dcdcdc !important;\r\n           \r\n        }\r\n        .a-viewChiTiet\r\n        {\r\n            color: #666;\r\n            position: absolute;\r\n            right: 0;\r\n        }\r\n        .divTieuDe\r\n        {\r\n            position: relative;\r\n        }\r\n        .div-title\r\n        {\r\n            position: relative;\r\n        }\r\n        .a-xoagridview\r\n        {\r\n            color: #D92B51;\r\n            position: absolute;\r\n            right: 0;\r\n            text-align:center;\r\n            padding-right:20px;\r\n            padding-top:5px;\r\n        }\r\n   .divChiTietXuLy\r\n        {\r\n            background: #fff none repeat scroll 0 0;                       \r\n            overflow-y: auto;\r\n            overflow-x: visible;\r\n            max-height:500px;\r\n        }"
